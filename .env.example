# Umami Cloud — optional override. The live site ID is already the app default.
# VITE_UMAMI_WEBSITE_ID=d7936d6c-c081-4e2e-b988-3c0d6bb7f781

# Optional. Defaults to the Umami Cloud script.
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Optional. Send events from localhost (off by default so local reloads stay out of the dashboard).
# VITE_UMAMI_TRACK_LOCAL=true
